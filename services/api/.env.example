# Server
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Public URL the Twilio webhook is configured to hit (used for signature verification)
PUBLIC_BASE_URL=https://api.grace.example.com

# Database (Supabase Postgres or self-hosted)
DATABASE_URL=postgres://user:pass@host:5432/grace
DATABASE_SSL=true

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Feature flags
RAG_ENABLED=true
TOOLS_ENABLED=true

# Admin (Bearer token for /admin/* — leave blank in dev to allow open access)
ADMIN_TOKEN=
