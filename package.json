{
  "name": "grace",
  "version": "0.1.0",
  "private": true,
  "description": "Grace — production-grade WhatsApp AI assistant for GLP-1 users.",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "test:ready": "bash scripts/test-ready.sh",
    "test:services:setup": "bash scripts/setup-local-test.sh",
    "test:services:stop": "bash scripts/stop-local-test.sh",
    "dev:local": "bash scripts/start-local-api.sh",
    "dev:api": "pnpm --filter @grace/api dev",
    "dev:web": "pnpm --filter @grace/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  }
}
