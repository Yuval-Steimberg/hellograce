# ─────────────────────────────────────────────────────────────────────────────
# apps/web — local dev environment
#
# Copy this file to `.env.local` (gitignored) and tweak as needed.
#   cp apps/web/.env.example apps/web/.env.local
#
# Two supported local-dev modes (see docs/LOCAL_DEV.md for full setup):
#
#   MODE 1 — "Web only, hit prod API" (fastest UI iteration)
#     Web runs at  http://localhost:8080
#     API is       https://grace-api.fly.dev (production!)
#     Use the values below as-is. Every action affects real production data.
#
#   MODE 2 — "Full local stack" (isolated, safe for destructive testing)
#     Run docker-compose first so API + Postgres + Redis come up on localhost.
#     Then change VITE_API_URL below to http://localhost:3001.
# ─────────────────────────────────────────────────────────────────────────────

# Grace API base URL. MODE 1 = production; MODE 2 = http://localhost:3001
VITE_API_URL="https://grace-api.fly.dev"

# Supabase (used by the legacy v1 edge functions — Stripe checkout etc.)
VITE_SUPABASE_PROJECT_ID="eohsyydvvbhjsfpegoob"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVvaHN5eWR2dmJoanNmcGVnb29iIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzU5MTcxNzIsImV4cCI6MjA5MTQ5MzE3Mn0.b7YViWG_pe37q1uFaUrdskqZheAOA3ycXMuB04nFp1M"
VITE_SUPABASE_URL="https://eohsyydvvbhjsfpegoob.supabase.co"

# Stripe publishable key. pk_test_* for local; pk_live_* in production Vercel.
# Must come from the same Stripe account as STRIPE_SECRET_KEY in Supabase.
# Apple Pay / Google Pay are surfaced automatically by the Express Checkout
# Element on supported devices — no extra frontend env var is needed, but the
# Stripe Dashboard must have the wallets enabled and the live domain verified.
# See docs/APPLE_GOOGLE_PAY.md for the production checklist.
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# WhatsApp deeplink — used on the onboarding success screen.
# Sandbox values: number = +14155238886, join code = your sandbox join word.
VITE_WHATSAPP_NUMBER="+14155238886"
VITE_WHATSAPP_JOIN_CODE=""
