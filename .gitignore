node_modules/
dist/
build/
coverage/
.next/
.turbo/
.cache/

# Coverage expansion data assets (intents.json + taxonomy + journey-map +
# safety-framework) ARE checked in — the broad `coverage/` rule above would
# otherwise ignore the entire services/api/coverage/ directory.
!services/api/coverage/
!services/api/coverage/**
# But the generator's draft output stays local (human review required first)
services/api/coverage/intents-expanded.json
services/api/coverage/results/

# env
.env
.env.local
.env.*.local
!.env.example

# logs
*.log
logs/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*

# editors
.vscode/*
!.vscode/extensions.json
.idea/

# os
.DS_Store
Thumbs.db

# eval results
services/api/eval/results/
services/api/auto-eval/results/

# build artifacts in non-dist dirs
services/api/auto-eval/*.js
services/api/auto-eval/*.js.map
services/api/auto-eval/*.d.ts
services/api/auto-eval/*.d.ts.map
services/api/eval/*.js
services/api/eval/*.js.map
services/api/eval/*.d.ts
services/api/eval/*.d.ts.map

# auto-eval build output (created by Docker build, not needed in repo)
services/api/dist-auto-eval

# misc
*.tsbuildinfo
*.bak
