# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Public URL the Twilio webhook is configured to hit.
# Used for Twilio signature verification in production.
PUBLIC_BASE_URL=https://api.yourdomain.com

# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase Postgres (or any Postgres + pgvector instance)
DATABASE_URL=postgres://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_SSL=true

# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Leave blank if using WhatsApp only
TWILIO_FROM_NUMBER=

# WhatsApp sender in "whatsapp:+E164" format
# Twilio sandbox: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── LLM (Gemini) ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local: redis://localhost:6379
# Upstash: rediss://default:[token]@[host].upstash.io:6379
REDIS_URL=redis://localhost:6379

# ─── Admin dashboard ──────────────────────────────────────────────────────────
# Bearer token for /admin/* endpoints.
# Leave blank in dev to skip auth. In prod: openssl rand -hex 32
ADMIN_TOKEN=

# ─── Stripe (optional — v1 Supabase functions handle billing) ─────────────────
# Payments (create-checkout, confirm-checkout, stripe-webhook) run in Supabase.
# Those functions update is_paid/is_pro in the shared DB which v2 reads.
# Only add these if you build a native v2 Stripe webhook handler later.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Feature flags ────────────────────────────────────────────────────────────
RAG_ENABLED=true
TOOLS_ENABLED=true
