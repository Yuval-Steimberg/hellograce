{
  "version": 1,
  "description": "Intent library — every question shape Grace must handle, with expected routing + safety level + grading checks. SEED set hand-curated for Phase 2 of the coverage expansion plan. Grow via scripts/generate-coverage-questions.ts (human review required before merging into this file).",
  "schema": {
    "id": "stable identifier; format <domain_short>.<subtopic>.<variant_n>",
    "domain": "one of: medication | side_effects | weight_loss | food | progress | emotional | exercise | social | safety | motivation",
    "subtopic": "subcategory from docs/coverage/taxonomy.md",
    "variations": "array of distinct user phrasings — all must classify the same way",
    "expected_intent": "MessageType from packages/ai-core/src/classify.ts",
    "expected_tool_calls": "tool names that MUST fire (empty array = no tool required)",
    "must_include": "lowercase substrings the response MUST contain (deterministic check)",
    "must_not_include": "lowercase substrings the response MUST NOT contain (deterministic check)",
    "safety_level": "informational | clinical_redirect | emergency (from coverage/safety-framework.json)",
    "journey_stages": "applicable stage ids from coverage/journey-map.json (empty = all stages)",
    "source": "synthetic_v1 | human_curated | production_log"
  },
